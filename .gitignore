*.swp
*.swo
*~
*.log


# ============================================================
# IDE projects generated by CMake
# ============================================================
# The source of truth is CMakeLists.txt. These are regenerated with:
#   cmake -S . -B build-xcode -G Xcode
#   cmake -S . -B build-vs -G "Visual Studio 17 2022"

# Visual Studio solutions and projects
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.sln.docstates

# Xcode projects and workspaces
*.xcodeproj/
*.xcworkspace/


# ============================================================
# Compiled / Object files
# ============================================================

*.o
*.obj
*.lo
*.slo

# Dependency files
*.d
*.dep

# Precompiled headers
*.gch
*.pch


# ============================================================
